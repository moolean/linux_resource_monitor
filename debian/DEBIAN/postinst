#!/bin/sh
# postinst script for linux-resource-monitor

set -e

case "$1" in
    configure)
        # Ensure executables have correct permissions
        chmod +x /usr/bin/resource_monitor.sh 2>/dev/null || true
        chmod +x /usr/bin/resource_monitor.py 2>/dev/null || true
        
        echo "Linux Resource Monitor installed successfully!"
        echo "Run 'resource_monitor.sh' for the shell version (high performance)"
        echo "Run 'resource_monitor.py' for the Python version (requires psutil)"
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
